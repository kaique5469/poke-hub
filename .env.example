# ── Banco de dados (Railway MySQL fornece essa URL automaticamente) ──────────
DATABASE_URL="mysql://user:pass@host:3306/pokehub"

# ── Sessão (obrigatório em produção — string longa e aleatória) ──────────────
JWT_SECRET="troque-por-uma-string-aleatoria-bem-longa"

# ── URL pública do app (usada nos callbacks do Google OAuth) ─────────────────
APP_URL="https://raritygrid.com"

# ── Admin: quem se registrar com este email vira admin automaticamente ───────
OWNER_EMAIL="owner@example.com"
SUPPORT_EMAIL="support@example.com"

# ── Email transacional (opcional, necessário para avisar vencedor/admin) ─────
RESEND_API_KEY=""
EMAIL_FROM="RarityGrid <notifications@raritygrid.com>"

# ── Google OAuth (opcional — sem isso, só login por email/senha) ─────────────
# Crie em https://console.cloud.google.com/apis/credentials
# Redirect URI autorizado: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Artigos diários com IA (opcional — sem chave, o endpoint só aceita
#    artigos pré-escritos enviados pelo cron) ─────────────────────────────────
OPENAI_API_KEY=""
OPENAI_SCANNER_MODEL="gpt-5-mini"

# ── Segredo do cron de artigos (header x-cron-secret) ────────────────────────
CRON_SECRET="outra-string-aleatoria"

# ── Preços CardMarket via RapidAPI (opcional) ────────────────────────────────
RAPIDAPI_KEY=""

# ── Catálogo expandido + vendas graduadas PSA 1–10 (opcional/comercial) ─────
# Chave somente no servidor. Para uso comercial, contrate um plano que inclua
# licença comercial e dados graduados em https://tcgpricelookup.com/pricing
TCG_PRICE_LOOKUP_API_KEY=""

# ── Catálogo real de produtos selados e preços em USD (Scrydex) ─────────────
SCRYDEX_API_KEY=""
SCRYDEX_TEAM_ID=""

# ── Drop Monitor em tempo quase real ────────────────────────────────────────────
# Endpoint de um provedor de inventário autorizado/licenciado. O RarityGrid
# não faz scraping direto de páginas de varejistas.
DROP_PROVIDER_URL=""
DROP_PROVIDER_API_KEY=""
# IDs separados por vírgula; use os valores documentados em shared/drops.ts
DROP_PROVIDER_RETAILERS=""
# Segredo HMAC para eventos enviados a POST /api/drop-provider/webhook
DROP_PROVIDER_WEBHOOK_SECRET="troque-por-um-segredo-longo"
DROP_WORKER_ENABLED="true"
DROP_NORMAL_INTERVAL_SECONDS="300"
DROP_BURST_INTERVAL_SECONDS="5"

# Canais privados opcionais para alertas imediatos do seu grupo
DROP_DISCORD_WEBHOOK_URL=""
DROP_TELEGRAM_BOT_TOKEN=""
DROP_TELEGRAM_CHAT_ID=""

# Web Push (inclui iPhone/iPad quando o PWA está instalado na Home Screen)
# Gere uma vez com: node scripts/generate-vapid-keys.mjs
DROP_VAPID_PUBLIC_KEY=""
DROP_VAPID_PRIVATE_KEY=""
DROP_VAPID_SUBJECT="mailto:support@raritygrid.com"

# ── RarityGrid Pro (assinatura via Stripe, mesmo webhook do marketplace) ────
# Crie os Prices no Stripe (recorrentes) e cole os IDs. BRL é opcional: sem
# ele, o checkout usa os preços em USD. Sem nenhum, o app mostra o paywall
# com "em breve" e nada é cobrado. Eventos extras do webhook:
# customer.subscription.created/updated/deleted, invoice.paid,
# invoice.payment_failed.
STRIPE_PRO_PRICE_MONTH_USD=""
STRIPE_PRO_PRICE_YEAR_USD=""
STRIPE_PRO_PRICE_MONTH_BRL=""
STRIPE_PRO_PRICE_YEAR_BRL=""

# ── Marketplace: checkout, escrow e repasses de vendedores (Stripe) ─────────
# Webhook público: {APP_URL}/api/stripe/webhook
# Eventos obrigatórios: checkout.session.completed, checkout.session.expired
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Pasta de uploads (no Railway, monte um Volume neste caminho) ─────────────
DATA_DIR="./data"
