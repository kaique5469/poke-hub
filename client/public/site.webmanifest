{
  "name": "RarityGrid",
  "short_name": "RarityGrid",
  "description": "Scan Pokémon cards, track your collection in USD and BRL, and get restock alerts.",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0d14",
  "theme_color": "#0b0d14",
  "shortcuts": [
    {
      "name": "Scan a card",
      "short_name": "Scan",
      "description": "Identify a card with the camera",
      "url": "/app/scan?source=shortcut",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Portfolio",
      "short_name": "Portfolio",
      "description": "Collection value in USD and BRL",
      "url": "/app/portfolio?source=shortcut",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Drop alerts",
      "short_name": "Alerts",
      "description": "Live Pokémon product restock alerts",
      "url": "/app/alerts?source=shortcut",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
